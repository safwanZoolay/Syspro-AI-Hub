# =============================================================================
# SYSPRO AI Hub - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values

# =============================================================================
# n8n Configuration
# =============================================================================

# Base URL for n8n webhook endpoints
# For local development: http://localhost:5678
# For production: https://your-n8n-instance.com
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Optional: API key for n8n authentication (if configured)
# N8N_API_KEY=your-api-key-here

# =============================================================================
# Application Settings
# =============================================================================

# Enable real n8n webhook calls (set to 'true' when n8n is running)
# When 'false' or unset, the app uses simulated execution for demo purposes
NEXT_PUBLIC_USE_REAL_WEBHOOKS=false

# Enable debug logging for agent execution
# DEBUG_AGENT_EXECUTION=true

# =============================================================================
# Future: Authentication (when implemented)
# =============================================================================

# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=your-secret-here

# =============================================================================
# Future: Database (when implemented)
# =============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/syspro_ai_hub
